{
  "name": "padvinder",
  "version": "0.8.0",
  "description": "Tiny, CSP-safe RFC 9535 JSONPath engine. No eval, no new Function.",
  "keywords": [
    "csp",
    "json",
    "jsonpath",
    "query",
    "rfc9535"
  ],
  "license": "Apache-2.0",
  "author": {
    "name": "Robin van der Vleuten",
    "email": "robin@webstronauts.com",
    "url": "https://robinvdvleuten.nl"
  },
  "repository": "getquario/padvinder",
  "files": [
    "lib"
  ],
  "type": "module",
  "module": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "scripts": {
    "bench": "node --disallow-code-generation-from-strings bench/index.js",
    "bench:comparison": "npm --prefix bench/comparison run bench",
    "check": "run-s fmt:check lint fallow size test fuzz:regression test:browser",
    "cts:update": "curl -sL -o test/cts.json https://raw.githubusercontent.com/jsonpath-standard/jsonpath-compliance-test-suite/main/cts.json && curl -sL -o test/cts.LICENSE https://raw.githubusercontent.com/jsonpath-standard/jsonpath-compliance-test-suite/main/LICENSE",
    "fallow": "fallow",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "fuzz": "npm run fuzz:prepare && run-s fuzz:compile fuzz:find fuzz:structured",
    "fuzz:compile": "NODE_OPTIONS=--disallow-code-generation-from-strings jazzer fuzz/compile.fuzz.js -i lib/ --customHooks fuzz/hooks.js --disableBugDetectors='command-injection|path-traversal' --sync .fuzz-corpus/compile fuzz/corpus/compile -- -max_total_time=60 -timeout=25 -use_value_profile=1 -dict=fuzz/padvinder.dict -artifact_prefix=fuzz/",
    "fuzz:find": "NODE_OPTIONS=--disallow-code-generation-from-strings jazzer fuzz/find.fuzz.js -i lib/ --customHooks fuzz/hooks.js --disableBugDetectors='command-injection|path-traversal' --sync .fuzz-corpus/find fuzz/corpus/find -- -max_total_time=60 -timeout=25 -use_value_profile=1 -dict=fuzz/padvinder.dict -artifact_prefix=fuzz/",
    "fuzz:prepare": "node -e \"for (const x of ['compile','find','structured']) require('fs').mkdirSync('.fuzz-corpus/'+x,{recursive:true})\"",
    "fuzz:regression": "run-s fuzz:regression:compile fuzz:regression:find fuzz:regression:structured",
    "fuzz:regression:compile": "NODE_OPTIONS=--disallow-code-generation-from-strings jazzer fuzz/compile.fuzz.js -i lib/ --customHooks fuzz/hooks.js --disableBugDetectors='command-injection|path-traversal' --sync --mode=regression fuzz/corpus/compile -- -timeout=25 -artifact_prefix=fuzz/",
    "fuzz:regression:find": "NODE_OPTIONS=--disallow-code-generation-from-strings jazzer fuzz/find.fuzz.js -i lib/ --customHooks fuzz/hooks.js --disableBugDetectors='command-injection|path-traversal' --sync --mode=regression fuzz/corpus/find -- -timeout=25 -artifact_prefix=fuzz/",
    "fuzz:regression:structured": "NODE_OPTIONS=--disallow-code-generation-from-strings jazzer fuzz/structured.fuzz.js -i lib/ --customHooks fuzz/hooks.js --disableBugDetectors='command-injection|path-traversal' --sync --mode=regression fuzz/corpus/structured -- -timeout=25 -artifact_prefix=fuzz/",
    "fuzz:structured": "NODE_OPTIONS=--disallow-code-generation-from-strings jazzer fuzz/structured.fuzz.js -i lib/ --customHooks fuzz/hooks.js --disableBugDetectors='command-injection|path-traversal' --sync .fuzz-corpus/structured fuzz/corpus/structured -- -max_total_time=60 -timeout=25 -use_value_profile=1 -dict=fuzz/padvinder.dict -artifact_prefix=fuzz/",
    "lint": "oxlint",
    "size": "size-limit",
    "test": "run-s test:unit test:types",
    "test:browser": "playwright install chromium && node test/browser/harness.js",
    "test:types": "tsc && attw --pack . --profile esm-only",
    "test:unit": "c8 --100 --src lib/ node --disallow-code-generation-from-strings --test --test-concurrency=1 test/*.test.js"
  },
  "dependencies": {
    "treffer": "^0.5.0",
    "waarmerk": "^0.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.3",
    "@jazzer.js/bug-detectors": "^4.0.0",
    "@jazzer.js/core": "^4.0.0",
    "@size-limit/preset-small-lib": "^13.0.3",
    "c8": "^12.0.0",
    "fallow": "^3.17.0",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "playwright": "^1.61.1",
    "size-limit": "^13.0.3",
    "typescript": "7.0.2"
  },
  "size-limit": [
    {
      "path": "lib/index.js",
      "ignore": [
        "waarmerk",
        "treffer"
      ],
      "limit": "4.55 kB"
    }
  ],
  "engines": {
    "node": ">=22.0.0"
  }
}
